#!/usr/bin/env bash

export HOMEBREW_NO_ANALYTICS="1"
export HOMEBREW_NO_INSECURE_REDIRECT="1"
export HOMEBREW_CASK_OPTS="--require-sha"

# Upgrade casks that legitimately ship `sha256 :no_check` (e.g. google-chrome),
# bypassing --require-sha for that one command only.
brew-upgrade-nosha() { HOMEBREW_CASK_OPTS="" brew upgrade "$@"; }

# Force-upgrade self-updating casks (chrome, postman, bruno, rectangle, ...).
# They auto-update in the background, so the app in /Applications drifts past the
# version brew recorded and `brew upgrade` reverts with "already an App at ...".
# --force overwrites the drifted app; empty CASK_OPTS also clears the sha check.
brew-upgrade-force() { HOMEBREW_CASK_OPTS="" brew upgrade --cask --force "$@"; }

if command -v /opt/homebrew/bin/brew >/dev/null 2>&1; then
  BREW_PREFIX="$(/opt/homebrew/bin/brew --prefix)"
  export BREW_PREFIX
  export PATH="${BREW_PREFIX}/opt/curl/bin:${BREW_PREFIX}/sbin:${BREW_PREFIX}/bin:${PATH}"

  [[ -r "${BREW_PREFIX}/etc/profile.d/bash_completion.sh" ]] && . "${BREW_PREFIX}/etc/profile.d/bash_completion.sh"
fi
