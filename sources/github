#!/usr/bin/env bash

if [[ -f "${HOME}/opt/bash-completion.d/gh" ]]; then
  source "${HOME}/opt/bash-completion.d/gh"
fi

# usage: pick_repos [org] [dest_dir]
pick_repos() (
  set -o pipefail

  local org="${1:-BatchLabs}"
  local dest="${2:-${HOME}/code/${org}}"
  mkdir -p "${dest}"

  gh repo list "${org}" --limit 1000 --no-archived \
    --json name -q '.[].name' |
  fzf --multi \
      --header 'TAB: select · ENTER: clone · CTRL-A: select all' \
      --bind 'ctrl-a:select-all' \
      --preview "gh repo view ${org}/{1} | head -50" \
      --preview-window=right:50%:wrap |
  while read -r repo; do
    if [[ -d "${dest}/${repo}/.git" ]]; then
      echo "skip ${repo} (already cloned)"
    else
      gh repo clone "${org}/${repo}" "${dest}/${repo}" -- --quiet && echo "cloned ${repo}"
    fi
  done
)
